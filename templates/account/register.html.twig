{% extends 'portal/access.html.twig' %}

{% block title %}Inscription{% endblock %}
{% block access_form %}
    <h1 id="heading">Créer un compte</h1>
    {{ form_start(form, {attr: {class: 'stack'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.nickname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        <button type="submit">Créer mon compte</button>
    {{ form_end(form) }}
    <p class="secondary">Déjà un compte ? <a href="{{ path('account_login') }}">Se connecter</a></p>
{% endblock %}

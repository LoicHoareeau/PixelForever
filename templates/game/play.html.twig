{% extends 'base.html.twig' %}

{% block title %}Val-des-Saules{% endblock %}
{% block layout %}game-layout{% endblock %}

{% block body %}
    {% set warrior = character.class.value == 'warrior' %}
    {% set weapon = warrior ? 'Épée de fer' : 'Bâton de braise' %}
    {% set basic = combat.basicName %}
    {% set resource = combat.resourceName|lower %}
    {% set resourcePhrase = warrior ? 'd’énergie' : 'de mana' %}
    {% set potions = {
        health: {name: 'Potion de vie', icon: 'icon-health', restore: combat.healthRestore},
        mana: {name: 'Potion ' ~ resourcePhrase, icon: 'icon-mana', restore: combat.manaRestore}
    } %}
    <section class="panel" aria-labelledby="zone-title">
        <div class="panel-heading">
            <h1 id="zone-title">Val-des-Saules</h1>
            <a href="{{ path('character_list') }}">Mes personnages</a>
        </div>
        <p id="game-status" role="status">Chargement de Val-des-Saules…</p>
        <div class="game-stage">
            <div id="combat-vitals" class="combat-vitals" hidden>
                <section class="player-hud" aria-label="État du personnage">
                    <img class="hud-portrait" src="{{ app.request.basePath }}/game/val-des-saules/{{ warrior ? 'noe' : 'lina' }}/south.png" width="48" height="48" alt="">
                    <div class="hud-stats">
                        <div class="hud-name"><strong>{{ character.name }}</strong><small>{{ character.class.label }} · Niv. <span id="combat-level">{{ character.level }}</span></small></div>
                        <label>Vie <meter id="combat-health" max="{{ combat.health }}" value="{{ combat.health }}"></meter>
                            <span id="combat-health-value">{{ combat.health }} / {{ combat.health }}</span>
                        </label>
                        <label>{{ combat.resourceName }} <meter id="combat-mana" class="{{ warrior ? 'energy-meter' : 'mana-meter' }}" max="{{ combat.mana }}" value="{{ combat.mana }}"></meter>
                            <span id="combat-mana-value">{{ combat.mana }} / {{ combat.mana }}</span>
                        </label>
                        <label>XP <meter id="combat-xp" class="xp-meter" max="100" value="0"></meter><span id="combat-xp-value">0 / 100</span></label>
                    </div>
                </section>
                <section class="target-hud" id="combat-target" aria-label="État de Saphyr" hidden>
                    <label>Saphyr <meter id="combat-target-health" max="96" value="96"></meter>
                        <span id="combat-target-health-value">96 / 96</span>
                    </label>
                </section>
            </div>
            <div id="world" class="game-map" data-class="{{ character.class.value }}" data-asset-path="{{ app.request.basePath }}/game/val-des-saules/" data-combat="{{ combat|json_encode|e('html_attr') }}"></div>
            <div id="combat-actions" class="combat-actions" hidden>
                <div class="action-slots" role="group" aria-label="Barre de sorts et d’objets">
                    <button class="action-slot" type="button" data-attack="basic" aria-keyshortcuts="1" title="{{ basic }}">
                        <kbd>1</kbd><span class="action-icon {{ warrior ? 'icon-sword' : 'icon-bolt' }}" aria-hidden="true"></span><span id="combat-basic-name">{{ basic }}</span>
                    </button>
                    <button class="action-slot" type="button" data-attack="special" aria-keyshortcuts="2" title="{{ combat.specialName }} · {{ combat.specialManaCost }} {{ resource }}">
                        <kbd>2</kbd><span class="action-icon {{ warrior ? 'icon-charge' : 'icon-fire' }}" aria-hidden="true"></span><span>{{ combat.specialName }}</span><small>{{ combat.specialManaCost }} {{ resource }}</small>
                    </button>
                    {% for type, potion in potions %}
                        <button class="action-slot" type="button" data-potion="{{ type }}" aria-keyshortcuts="{{ loop.index + 2 }}" title="{{ potion.name }}">
                            <kbd>{{ loop.index + 2 }}</kbd><span class="action-icon {{ potion.icon }}" aria-hidden="true"></span><span>{{ potion.name }}</span><small data-quantity="{{ type }}">2</small>
                        </button>
                    {% endfor %}
                    <button id="inventory-open" class="action-slot inventory-slot" type="button" aria-keyshortcuts="I" aria-haspopup="dialog" title="Inventaire">
                        <kbd>I</kbd><span class="action-icon icon-bag" aria-hidden="true"></span><span>Inventaire</span>
                    </button>
                </div>
                <p id="combat-status" role="status"></p>
                <button type="button" id="combat-reset" class="quiet" hidden>Se relever au camp</button>
            </div>
        </div>
        <div class="game-directions" role="group" aria-label="Déplacer le personnage" hidden>
            <button class="quiet" type="button" data-direction="north" aria-label="Monter">↑</button>
            <button class="quiet" type="button" data-direction="west" aria-label="Aller à gauche">←</button>
            <button class="quiet" type="button" data-direction="south" aria-label="Descendre">↓</button>
            <button class="quiet" type="button" data-direction="east" aria-label="Aller à droite">→</button>
        </div>
        <p id="game-controls">Déplacement avec les flèches, ZQSD ou WASD.</p>
        <dialog id="inventory" aria-labelledby="inventory-title" aria-describedby="inventory-description">
            <div class="inventory-heading">
                <h2 id="inventory-title">Inventaire</h2>
                <form method="dialog"><button type="submit" class="quiet" autofocus>Fermer</button></form>
            </div>
            <p id="inventory-description">Saphyr laisse un objet à chaque victoire.</p>
            <ul class="inventory-items">
                <li>
                    <span class="action-icon {{ warrior ? 'icon-sword' : 'icon-staff' }}" aria-hidden="true"></span>
                    <div><strong>{{ weapon }}</strong><small data-weapon-state="starter">Équipé · +{{ combat.weaponBonus }} dégâts de base</small></div>
                    <button type="button" id="inventory-equip" class="quiet" data-weapon="starter">Retirer</button>
                </li>
                {% for type, potion in potions %}
                    <li>
                        <span class="action-icon {{ potion.icon }}" aria-hidden="true"></span>
                        <div><strong>{{ potion.name }} ×<span data-quantity="{{ type }}">2</span></strong><small>+{{ potion.restore }} {{ type == 'health' ? 'PV' : 'points ' ~ resourcePhrase }} · Commun · {{ combat.loot[type].chance }} %</small></div>
                        <button type="button" class="quiet" data-potion="{{ type }}" aria-label="Boire · {{ potion.name }}">Boire</button>
                    </li>
                {% endfor %}
                {% for type in ['rare', 'epic'] %}
                    {% set item = combat.loot[type] %}
                    <li>
                        <span class="action-icon {{ warrior ? 'icon-charge' : 'icon-staff' }}" aria-hidden="true"></span>
                        <div>
                            <strong>{{ item.name }} ×<span data-quantity="{{ type }}">0</span></strong>
                            <small><span class="loot-{{ type }}">{{ item.rarity }} · {{ item.chance }} %</span> · +{{ item.bonus }} dégâts de base <span data-weapon-state="{{ type }}"></span></small>
                        </div>
                        <button type="button" class="quiet" data-weapon="{{ type }}" disabled>Équiper</button>
                    </li>
                {% endfor %}
            </ul>
            <p id="inventory-status" role="status"></p>
        </dialog>
        <noscript><p>Active JavaScript pour déplacer ton personnage.</p></noscript>
    </section>
    <script src="{{ app.request.basePath }}/game/phaser-3.90.0.min.js" defer></script>
    <script src="{{ app.request.basePath }}/game/world.js" type="module"></script>
{% endblock %}

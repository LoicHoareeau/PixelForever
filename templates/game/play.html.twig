{% extends 'base.html.twig' %}

{% block title %}Val-des-Saules{% endblock %}
{% block body_class %}game-fullscreen{% endblock %}
{% block layout %}game-layout{% endblock %}

{% block body %}
    {% set warrior = character.class.value == 'warrior' %}
    {% set weapon = warrior ? 'Épée de fer' : 'Baguette de braise' %}
    {% set basic = combat.basicName %}
    {% set resource = combat.resourceName|lower %}
    {% set resourcePhrase = warrior ? 'd’énergie' : 'de mana' %}
    {% set initialBasicDamage = combat.basicDamage + combat.weaponBonus %}
    {% set baseStats = combat.baseStats %}
    {% set growthStats = combat.growthStats %}
    {% set potions = {
        health: {
            name: 'Vie',
            fullName: 'Potion de vie',
            icon: 'icon-health',
            key: 'R',
            restore: combat.healthRestore
        },
        mana: {
            name: warrior ? 'Énergie' : 'Mana',
            fullName: 'Potion ' ~ resourcePhrase,
            icon: 'icon-mana',
            key: 'F',
            restore: combat.manaRestore
        }
    } %}
    {% set statDefinitions = [
        {
            key: 'strength',
            label: 'Force',
            effect: warrior ? 'Augmente fortement les dégâts de mêlée' : 'Renforce légèrement les attaques physiques'
        },
        {
            key: 'intelligence',
            label: 'Intelligence',
            effect: warrior ? 'Renforce légèrement la compétence et la régénération' : 'Augmente les dégâts des sorts et la régénération'
        },
        {
            key: 'vitality',
            label: 'Vitalité',
            effect: '+4 PV maximum par point'
        },
        {
            key: 'spirit',
            label: 'Esprit',
            effect: warrior ? '+3 ' ~ resource ~ ' max et +0,4/s de régénération' : '+3 ' ~ resource ~ ' max et +0,14/s de régénération'
        }
    ] %}

    <section class="game-viewport" aria-label="Val-des-Saules">
        <p id="game-status" role="status">Chargement de Val-des-Saules…</p>

        {# Scène plein écran : canvas Phaser + ATH flottant #}
        <div class="game-stage">
            <div
                id="world"
                class="game-map"
                data-class="{{ character.class.value }}"
                data-skin="{{ character.class.skin }}"
                data-asset-path="{{ app.request.basePath }}/game/val-des-saules/"
                data-combat="{{ combat|json_encode|e('html_attr') }}"
            ></div>

            {# ATH haut : Joueur à gauche, Cible au centre, Menu rapide à droite #}
            <div id="combat-vitals" class="combat-vitals" hidden>
                <section class="player-hud" aria-label="État du personnage">
                    <img
                        class="hud-portrait"
                        src="{{ app.request.basePath }}/game/val-des-saules/{{ character.class.skin }}/south.png"
                        width="48"
                        height="48"
                        alt=""
                    >
                    <div class="hud-stats">
                        <div class="hud-name">
                            <strong>{{ character.name }}</strong>
                            <small class="hud-level-pill">
                                {{ character.class.label }} · Niv. <span id="combat-level">{{ character.level }}</span>
                            </small>
                        </div>
                        <small id="progress-save-status" role="status"></small>
                        <label>
                            <span>Vie</span>
                            <meter
                                id="combat-health"
                                max="{{ combat.health }}"
                                value="{{ combat.health }}"
                            ></meter>
                            <span id="combat-health-value">{{ combat.health }} / {{ combat.health }}</span>
                        </label>
                        <label>
                            <span>{{ combat.resourceName }}</span>
                            <meter
                                id="combat-mana"
                                class="{{ warrior ? 'energy-meter' : 'mana-meter' }}"
                                max="{{ combat.mana }}"
                                value="{{ combat.mana }}"
                            ></meter>
                            <span class="hud-resource-values">
                                <span id="combat-mana-value">{{ combat.mana }} / {{ combat.mana }}</span>
                                <small class="hud-regen">
                                    (+<span id="combat-mana-regen">{{ combat.baseManaRegen }}</span>/s)
                                </small>
                            </span>
                        </label>
                    </div>
                </section>

                <section class="target-hud" id="combat-target" aria-label="Cible sélectionnée" hidden>
                    <div class="target-header">
                        <strong id="combat-target-name">Saphyr</strong>
                        <span id="combat-target-level" class="target-level-badge">Niv. 10</span>
                    </div>
                    <small id="combat-target-phase" class="target-phase" hidden></small>
                    <label>
                        <span class="target-meter">
                            <meter id="combat-target-health" max="96" value="96"></meter>
                            <span class="target-thresholds" aria-hidden="true"></span>
                        </span>
                        <span id="combat-target-health-value">96 / 96</span>
                    </label>
                </section>

                <div class="top-right-hud">
                    <span id="current-zone" class="zone-badge">Clairière · N.1–5</span>
                    <button id="quest-open" class="hud-quick-btn" type="button" aria-haspopup="dialog" aria-controls="quest-dialog">Quête (E)</button>
                    <button
                        id="hud-sheet-open"
                        class="hud-quick-btn"
                        type="button"
                        aria-haspopup="dialog"
                    >
                        Fiche (C)
                    </button>
                    <a class="hud-quick-link" href="{{ path('character_list') }}">Personnages</a>
                </div>
            </div>

            {# Journal de combat flottant, barre d'incantation et bouton de résurrection #}
            <div class="floating-feedback">
                <div id="cast-bar" class="cast-bar" role="status" hidden>
                    <div class="cast-bar-header">
                        <strong id="cast-bar-name">Incantation</strong>
                        <span id="cast-bar-time">1.0s</span>
                    </div>
                    <meter id="cast-bar-meter" max="100" value="0"></meter>
                </div>
                <p id="combat-status" role="status"></p>
                <button
                    type="button"
                    id="combat-reset"
                    class="resurrect-btn"
                    hidden
                >
                    Se relever au camp
                </button>
            </div>

            {# Barre de sorts MMO plein écran (bas centre) #}
            <div id="combat-actions" class="combat-actions" hidden>
                <div class="action-bar-frame">
                    <span class="bar-ornament bar-ornament-left" aria-hidden="true"></span>

                    <div class="action-bar-core">
                        {# Barre d'XP intégrée façon MMO #}
                        <div class="xp-bar-wrap" aria-label="Expérience">
                            <meter
                                id="combat-xp"
                                class="xp-meter"
                                max="100"
                                value="0"
                            ></meter>
                            <span class="xp-bar-text">XP : <span id="combat-xp-value">0 / 100</span></span>
                        </div>

                        <div class="action-bar-row">
                            <div class="action-slots" role="group" aria-label="Barre de sorts">
                                {# Slot 1 : Attaque de base #}
                                <button
                                    class="action-slot"
                                    type="button"
                                    data-attack="basic"
                                    aria-keyshortcuts="1"
                                    title="{{ basic }}"
                                >
                                    <kbd>1</kbd>
                                    <span class="action-icon {{ warrior ? 'icon-sword' : 'icon-bolt' }}" aria-hidden="true"></span>
                                    <span class="slot-name" id="combat-basic-name">{{ basic }}</span>
                                    <small class="slot-meta" id="combat-basic-meta">Rg 1 · {{ initialBasicDamage }}</small>
                                    <span class="slot-cd" aria-hidden="true"></span>
                                </button>

                                {# Slot 2 : Sort spécial de base #}
                                <button
                                    class="action-slot"
                                    type="button"
                                    data-attack="special"
                                    aria-keyshortcuts="2"
                                    title="{{ combat.specialName }} · {{ combat.specialManaCost }} {{ resource }}"
                                >
                                    <kbd>2</kbd>
                                    <span class="action-icon {{ warrior ? 'icon-charge' : 'icon-fire' }}" aria-hidden="true"></span>
                                    <span class="slot-name">{{ combat.specialName }}</span>
                                    <small class="slot-meta" id="combat-special-meta">{{ combat.specialManaCost }} {{ resource }}</small>
                                    <span class="slot-cd" aria-hidden="true"></span>
                                </button>

                                {# Slots 3 à 6 : Sorts actifs débloqués dans l'arbre de talents #}
                                {% for i in 0..3 %}
                                    <button
                                        class="action-slot"
                                        type="button"
                                        data-attack="talent-{{ i }}"
                                        data-talent-slot="{{ i }}"
                                        data-unlocked="false"
                                        aria-keyshortcuts="{{ i + 3 }}"
                                        title="Emplacement {{ i + 3 }} · Débloquer dans l'arbre de talents (T)"
                                    >
                                        <kbd>{{ i + 3 }}</kbd>
                                        <span class="action-icon icon-locked" aria-hidden="true"></span>
                                        <span class="slot-name">Verrouillé</span>
                                        <small class="slot-meta">Talent (T)</small>
                                        <span class="slot-cd" aria-hidden="true"></span>
                                    </button>
                                {% endfor %}
                            </div>

                            <div class="potion-slots" role="group" aria-label="Potions">
                                {% for type, potion in potions %}
                                    <button
                                        class="action-slot potion-slot"
                                        type="button"
                                        data-potion="{{ type }}"
                                        aria-keyshortcuts="{{ potion.key }}"
                                        title="{{ potion.fullName }}"
                                    >
                                        <kbd>{{ potion.key }}</kbd>
                                        <span class="action-icon {{ potion.icon }}" aria-hidden="true"></span>
                                        <span class="slot-name">{{ potion.name }}</span>
                                        <small class="slot-qty" data-quantity="{{ type }}">2</small>
                                    </button>
                                {% endfor %}
                            </div>

                            {# Micro-menu MMO (Fiche, Talents, Sac) #}
                            <div class="micro-menu" role="group" aria-label="Menus du personnage">
                                <button
                                    id="character-open"
                                    class="micro-btn"
                                    type="button"
                                    aria-keyshortcuts="C"
                                    aria-haspopup="dialog"
                                    title="Fiche & Caractéristiques (C)"
                                >
                                    <span class="action-icon icon-sheet" aria-hidden="true"></span>
                                    <span class="micro-key">C</span>
                                    <span id="character-points-badge" class="micro-badge" data-has-points="false"></span>
                                </button>

                                <button
                                    id="talents-open"
                                    class="micro-btn"
                                    type="button"
                                    aria-keyshortcuts="T"
                                    aria-haspopup="dialog"
                                    title="Arbre de talents & Sorts (T)"
                                >
                                    <span class="action-icon icon-talent" aria-hidden="true"></span>
                                    <span class="micro-key">T</span>
                                    <span id="talent-points-badge" class="micro-badge" data-has-points="false"></span>
                                </button>

                                <button
                                    id="inventory-open"
                                    class="micro-btn"
                                    type="button"
                                    aria-keyshortcuts="I"
                                    aria-haspopup="dialog"
                                    title="Inventaire (I)"
                                >
                                    <span class="action-icon icon-bag" aria-hidden="true"></span>
                                    <span class="micro-key">I</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <span class="bar-ornament bar-ornament-right" aria-hidden="true"></span>
                </div>
            </div>

            {# Contrôles tactiles / souris #}
            <div class="game-directions" role="group" aria-label="Déplacer le personnage" hidden>
                <button class="quiet" type="button" data-direction="north" aria-label="Monter">↑</button>
                <button class="quiet" type="button" data-direction="west" aria-label="Aller à gauche">←</button>
                <button class="quiet" type="button" data-direction="south" aria-label="Descendre">↓</button>
                <button class="quiet" type="button" data-direction="east" aria-label="Aller à droite">→</button>
            </div>
        </div>

        <p id="game-controls" class="sr-only">
            Déplacement avec les flèches, ZQSD ou WASD · Changer de cible (Tab) · Parler (E) · Sorts (1-6) · Potions (R/F) · Fiche (C) · Talents (T) · Sac (I).
        </p>

        {# Fenêtre modale : Inventaire #}
        <dialog id="inventory" aria-labelledby="inventory-title" aria-describedby="inventory-description">
            <div class="inventory-heading">
                <h2 id="inventory-title">Inventaire</h2>
                <form method="dialog">
                    <button type="submit" class="quiet" autofocus>Fermer</button>
                </form>
            </div>
            <p id="inventory-description">Les monstres vaincus laissent du butin dans ton sac.</p>
            <ul class="inventory-items">
                <li>
                    <span class="action-icon {{ warrior ? 'icon-sword' : 'icon-staff' }}" aria-hidden="true"></span>
                    <div>
                        <strong>{{ weapon }}</strong>
                        <small data-weapon-state="starter">Équipé · +{{ combat.weaponBonus }} dégâts de base</small>
                    </div>
                    <button
                        type="button"
                        id="inventory-equip"
                        class="quiet"
                        data-weapon="starter"
                    >
                        Retirer
                    </button>
                </li>
                {% for type, potion in potions %}
                    <li>
                        <span class="action-icon {{ potion.icon }}" aria-hidden="true"></span>
                        <div>
                            <strong>{{ potion.fullName }} ×<span data-quantity="{{ type }}">2</span></strong>
                            <small>+{{ potion.restore }} {{ type == 'health' ? 'PV' : 'points ' ~ resourcePhrase }} · Commun · {{ combat.loot[type].chance }} %</small>
                        </div>
                        <button
                            type="button"
                            class="quiet"
                            data-potion="{{ type }}"
                            aria-label="Boire · {{ potion.fullName }}"
                        >
                            Boire
                        </button>
                    </li>
                {% endfor %}
                {% for type in ['rare', 'epic', 'scale', 'heart'] %}
                    {% set item = combat.loot[type] %}
                    <li>
                        <img class="action-icon pixel-item" src="{{ app.request.basePath }}/game/val-des-saules/items/{{ item.icon }}.png" alt="">
                        <div>
                            <strong>{{ item.name }} ×<span data-quantity="{{ type }}">0</span></strong>
                            <small>
                                <span class="loot-{{ type }}">{{ item.rarity }} · {{ item.chance }} %</span>
                                {% if item.bonus is defined %}
                                    · +{{ item.bonus }} dégâts de base · {{ item.usage }}
                                    <span data-weapon-state="{{ type }}"></span>
                                {% else %} · Matériau de butin{% endif %}
                            </small>
                        </div>
                        {% if item.bonus is defined %}<button
                            type="button"
                            class="quiet"
                            data-weapon="{{ type }}"
                            disabled
                        >
                            Équiper
                        </button>{% endif %}
                    </li>
                {% endfor %}
            </ul>
            <h3>Coiffes et gants</h3>
            <ul class="inventory-items" id="inventory-armor"></ul>
            <p id="inventory-status" role="status"></p>
        </dialog>

        <dialog id="quest-dialog" aria-labelledby="quest-title" aria-describedby="quest-description">
            <div class="inventory-heading">
                <h2 id="quest-title">Sécuriser le sentier</h2>
                <form method="dialog">
                    <button class="quiet" type="submit" autofocus>Fermer</button>
                </form>
            </div>
            <p>Habitante du hameau</p>
            <p id="quest-description"></p>
            <p id="quest-progress" role="status"></p>
            <p>Récompense : <strong>2 potions de vie</strong></p>
            <button id="quest-action" type="button">Accepter la quête</button>
        </dialog>

        {# Fenêtre modale : Arbre de Talents & Sorts (3 branches) #}
        <dialog id="talent-tree" aria-labelledby="talent-tree-title">
            <div class="inventory-heading">
                <div>
                    <h2 id="talent-tree-title">Talents &amp; Sorts · {{ character.class.label }}</h2>
                    <p class="talent-subtitle">Investis tes points de talent pour améliorer tes passifs et débloquer de nouveaux sorts actifs.</p>
                </div>
                <div class="talent-header-actions">
                    <span id="talent-points-count" class="points-pill">{{ combat.initialSpellPoints }} point disponible</span>
                    <button type="button" id="talent-reset-btn" class="quiet">Réinitialiser</button>
                    <form method="dialog">
                        <button type="submit" class="quiet" autofocus>Fermer</button>
                    </form>
                </div>
            </div>

            <div id="talent-tree-branches" class="talent-branches"></div>

            <div class="talent-footer">
                <div id="talent-tooltip" class="talent-tooltip">
                    <strong>Survole ou clique sur un talent</strong>
                    <span class="tooltip-type">Aperçu</span>
                    <p>Les sorts actifs débloqués s’ajoutent automatiquement dans ta barre de sorts (touches 3 à 6).</p>
                </div>
                <p id="talent-tree-status" role="status"></p>
            </div>
        </dialog>

        {# Fenêtre modale : Fiche de personnage, caractéristiques et sorts de base #}
        <dialog id="character-sheet" aria-labelledby="character-sheet-title" aria-describedby="character-sheet-description">
            <div class="inventory-heading">
                <h2 id="character-sheet-title">Fiche de {{ character.name }}</h2>
                <form method="dialog">
                    <button type="submit" class="quiet" autofocus>Fermer</button>
                </form>
            </div>
            <p id="character-sheet-description">
                Chaque niveau augmente naturellement tes caractéristiques et octroie +{{ combat.statPointsPerLevel }} points de stats et +{{ combat.spellPointsPerLevel }} point de talent.
            </p>

            <div class="sheet-sections">
                <section class="sheet-card sheet-summary" aria-labelledby="sheet-summary-title">
                    <h3 id="sheet-summary-title">Fiche de personnage</h3>
                    <dl class="sheet-grid">
                        <div>
                            <dt>Identité</dt>
                            <dd>{{ character.name }} · {{ character.class.label }}</dd>
                        </div>
                        <div>
                            <dt>Niveau</dt>
                            <dd><strong data-sheet-level>{{ character.level }}</strong></dd>
                        </div>
                        <div>
                            <dt>Expérience</dt>
                            <dd><strong data-sheet-xp>0 / 100</strong></dd>
                        </div>
                        <div>
                            <dt>Arme équipée</dt>
                            <dd><strong data-sheet-weapon>{{ weapon }}</strong></dd>
                        </div>
                        <div><dt>Coiffe</dt><dd><strong data-sheet-armor="head">Vide</strong></dd></div>
                        <div><dt>Gants</dt><dd><strong data-sheet-armor="hands">Vide</strong></dd></div>
                        <div>
                            <dt>PV max.</dt>
                            <dd><strong data-sheet-max-health>{{ combat.health }}</strong></dd>
                        </div>
                        <div>
                            <dt>{{ combat.resourceName }} max.</dt>
                            <dd><strong data-sheet-max-mana>{{ combat.mana }}</strong></dd>
                        </div>
                        <div>
                            <dt>Régénération auto</dt>
                            <dd><strong data-sheet-mana-regen>+{{ combat.baseManaRegen }}/s</strong></dd>
                        </div>
                        <div>
                            <dt>{{ basic }}</dt>
                            <dd><strong data-sheet-basic-damage>{{ initialBasicDamage }} dégâts</strong></dd>
                        </div>
                        <div>
                            <dt>{{ combat.specialName }}</dt>
                            <dd><strong data-sheet-special-damage>{{ combat.specialDamage }} dégâts</strong></dd>
                        </div>
                        <div>
                            <dt>Portée</dt>
                            <dd><strong data-sheet-range>{{ combat.range }} {{ combat.range < 2 ? 'case' : 'cases' }}</strong></dd>
                        </div>
                    </dl>
                </section>

                <section class="sheet-card sheet-stats" aria-labelledby="sheet-stats-title">
                    <div class="sheet-card-heading">
                        <h3 id="sheet-stats-title">Fiche de caractéristiques</h3>
                        <span id="stat-points-count" class="points-pill">{{ combat.initialStatPoints }} points disponibles</span>
                    </div>
                    <p class="sheet-note">
                        Croissance naturelle par niveau :
                        +{{ growthStats.strength }} Force ·
                        +{{ growthStats.intelligence }} Intelligence ·
                        +{{ growthStats.vitality }} Vitalité ·
                        +{{ growthStats.spirit }} Esprit.
                    </p>
                    <ul class="stat-list">
                        {% for stat in statDefinitions %}
                            <li class="stat-row">
                                <div class="stat-info">
                                    <strong>{{ stat.label }} : <span data-stat-total="{{ stat.key }}">{{ baseStats[stat.key] }}</span></strong>
                                    <small data-stat-detail="{{ stat.key }}">Base {{ baseStats[stat.key] }} · Naturel +0 · Investi +0</small>
                                    <small class="stat-effect">{{ stat.effect }}</small>
                                </div>
                                <button
                                    type="button"
                                    class="quiet"
                                    data-allocate-stat="{{ stat.key }}"
                                    aria-label="Augmenter {{ stat.label }}"
                                >
                                    +1
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                </section>

                <section class="sheet-card sheet-spells" aria-labelledby="sheet-spells-title">
                    <div class="sheet-card-heading">
                        <h3 id="sheet-spells-title">Maîtrise des sorts de base</h3>
                        <span id="spell-points-count" class="points-pill">{{ combat.initialSpellPoints }} point disponible</span>
                    </div>
                    <ul class="spell-list">
                        <li class="spell-row">
                            <span class="action-icon {{ warrior ? 'icon-sword' : 'icon-bolt' }}" aria-hidden="true"></span>
                            <div class="spell-info">
                                <div class="spell-title">
                                    <strong>{{ basic }}</strong>
                                    <span class="spell-rank-badge" data-spell-rank="basic">Rang 1</span>
                                </div>
                                <small data-spell-damage="basic">
                                    {{ initialBasicDamage }} dégâts actuels (+{{ combat.basicSpellRankBonus }} par rang)
                                </small>
                            </div>
                            <button
                                type="button"
                                class="quiet"
                                data-upgrade-spell="basic"
                            >
                                Améliorer (+1)
                            </button>
                        </li>
                        <li class="spell-row">
                            <span class="action-icon {{ warrior ? 'icon-charge' : 'icon-fire' }}" aria-hidden="true"></span>
                            <div class="spell-info">
                                <div class="spell-title">
                                    <strong>{{ combat.specialName }}</strong>
                                    <span class="spell-rank-badge" data-spell-rank="special">Rang 1</span>
                                </div>
                                <small data-spell-damage="special">
                                    {{ combat.specialDamage }} dégâts actuels (+{{ combat.specialSpellRankBonus }} par rang · Coût : {{ combat.specialManaCost }} {{ resource }})
                                </small>
                            </div>
                            <button
                                type="button"
                                class="quiet"
                                data-upgrade-spell="special"
                            >
                                Améliorer (+1)
                            </button>
                        </li>
                    </ul>
                </section>
            </div>

            <p id="character-sheet-status" role="status"></p>
        </dialog>

        <noscript>
            <p>Active JavaScript pour déplacer ton personnage.</p>
        </noscript>
    </section>

    <script src="{{ app.request.basePath }}/game/phaser-3.90.0.min.js" defer></script>
    <script src="{{ app.request.basePath }}/game/world.js" type="module"></script>
{% endblock %}
